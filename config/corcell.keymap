#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/runtime-input-processor.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";
        layer-1 {
            bindings = <
                &kp ESCAPE    &kp Q    &kp W    &kp E    &kp R    &kp T
                &kp Y    &kp U    &kp I    &kp O    &kp P    &lt 1 UP
                &kp TAB    &kp A    &kp S    &kp D    &kp F    &kp G
                &kp H    &kp J    &kp K    &kp L    &kp LEFT    &lt 2 RIGHT
                &kp LEFT_CONTROL    &kp Z    &kp X    &kp C    &kp V    &kp B
                &lt 3 GRAVE    &kp DELETE    &kp N    &kp M    &kp COMMA    &kp PERIOD
                &kp SLASH    &mt RIGHT_SHIFT DOWN    &mt LEFT_SHIFT SPACE    &kp LEFT_GUI    &kp LEFT_ALT    &lt 1 LANG2
                &lt 2 SPACE    &lt 5 LANG1    &kp BACKSPACE    &mt 537329893 458792    &lt 5 A    &kp INT4
                &kp LEFT_BRACKET    &lt 5 INT1
            >;
        };
        layer-2 {
            bindings = <
                &trans    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &trans
                &trans    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
                &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &trans
                &trans    &trans    &kp PAGE_UP    &trans    &kp HOME    &kp END
                &kp 34013221    &kp 34013222    &kp MINUS    &kp EQUAL    &kp SEMICOLON    &kp SQT
                &trans    &trans    &trans    &trans    &kp PAGE_DOWN    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans
            >;
        };
        layer-3 {
            bindings = <
                &trans    &kp 34013214    &kp 34013215    &kp 34013216    &kp 34013217    &kp 34013218
                &kp 34013219    &kp 34013220    &kp 34013221    &kp 34013222    &trans    &kp PAGE_UP
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &kp HOME    &kp END
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &kp PAGE_DOWN    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans
            >;
        };
        layer-4 {
            bindings = <
                &studio_unlock    &trans    &trans    &trans    &trans    &trans
                &bt BT_SEL 0    &out OUT_BLE    &out OUT_USB    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &bt BT_SEL 1    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &bt BT_CLR    &bt BT_SEL 2    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &studio_unlock    &trans
                &trans    &trans
            >;
        };
        layer-5 {
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &mkp MB1    &mkp MB3    &mkp MB2    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans
            >;
        };
        layer-6 {
            bindings = <
                &trans    &trans    &trans    &kp 17236043    &kp 17236046    &kp 50790423
                &kp 134676561    &kp 134676505    &mkp MB4    &mkp MB5    &kp 84344875    &kp ESCAPE
                &kp 84344875    &trans    &kp 17235990    &trans    &kp 17235977    &kp INS
                &kp 17235994    &kp 17235993    &kp 17235997    &kp 17235996    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &kp 67567677    &kp 17235995    &kp 17235974    &kp 50790443    &kp 17236011
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans
            >;
        };
        layer-7 {
            bindings = <
                &trans    &kp Q    &kp L    &kp U    &kp COMMA    &kp PERIOD
                &kp F    &kp W    &kp R    &kp Y    &kp P    &kp SLASH
                &trans    &kp E    &kp I    &kp A    &kp O    &kp MINUS
                &kp K    &kp T    &kp N    &kp S    &kp H    &trans
                &trans    &kp Z    &kp X    &kp C    &kp V    &kp SEMICOLON
                &trans    &trans    &kp G    &kp D    &kp M    &kp J
                &kp B    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans
            >;
        };
    };
};
